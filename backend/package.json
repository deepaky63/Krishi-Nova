{
  "name": "krishi-nova-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "openapi:validate": "node -e \"import('yaml').then(({parse}) => { parse(require('fs').readFileSync('docs/openapi.yaml', 'utf8')); console.log('OpenAPI YAML valid'); })\""
